      "note": "Uses the same x64 C++ import library and DLL for Debug and Release."
    },
    {
      "name": "OpenCV",
      "version": "4.7.0-dev",
      "versionEvidence": "includes/opencv/build/include/opencv2/core/version.hpp",
      "note": "Preserve the bundled vc16 x64 binaries matching these headers; include separate Debug/Release world and MSMF plugins plus shared FFmpeg plugin."
    },
    {
      "name": "Efort SDK",
      "version": "V2.5 (directory label)",
      "versionEvidence": "includes/SDK V2.5/sdk-x64",
      "note": "Exact binary revision was not independently identified. Both Debug/Release library pairs are vendor inputs."
    },
    {
      "name": "KW camera SDK",
      "version": "D_1.0 / SDK_windows_1.0 (directory labels)",
      "versionEvidence": "includes/KW_SDK_D_1.0/SDK_1.0/SDK_windows_1.0/lib/CPP",
      "note": "Exact binary revision was not independently identified."
    },
    {
      "name": "Harmo robot service",
      "version": null,
      "versionEvidence": "includes/robot/64",
      "note": "Version unavailable from retained filenames. Includes x64 service DLL, import library and API headers."
    },
    {
      "name": "TinyXML2 license",
      "note": "Library source is retained at repository root; this archive preserves its existing upstream license file."
    }
  ],
